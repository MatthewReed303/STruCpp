(* Function block inheritance in the IEC forms (IEC 61131-3 6.6.7.2.7-11):
   SUPER() runs the base body, calls bind dynamically, SUPER.m(), THIS. *)
INTERFACE I_KIND
  METHOD Kind : INT
  END_METHOD
END_INTERFACE

FUNCTION_BLOCK ABSTRACT BaseFB IMPLEMENTS I_KIND
  VAR_INPUT a : INT; END_VAR
  VAR_OUTPUT x : INT; END_VAR
  VAR PROTECTED calls : INT; END_VAR
  VAR PRIVATE secret : INT; END_VAR
  METHOD PUBLIC Kind : INT
    Kind := 1;
  END_METHOD
  METHOD PUBLIC ABSTRACT Scale : INT
  END_METHOD
  METHOD PROTECTED Bump
    calls := calls + 1;
  END_METHOD
  x := a + 1;
  THIS.Bump();
END_FUNCTION_BLOCK

FUNCTION_BLOCK Derived1 EXTENDS BaseFB
  VAR_INPUT b : INT; END_VAR
  METHOD PUBLIC OVERRIDE Kind : INT
    Kind := SUPER.Kind() + 10;
  END_METHOD
  METHOD PUBLIC Scale : INT
    Scale := 3;
  END_METHOD
  SUPER();
  x := THIS.Scale() * x + b;
END_FUNCTION_BLOCK

FUNCTION_BLOCK FINAL Derived2 EXTENDS Derived1
  VAR_IN_OUT c : INT; END_VAR
  METHOD PUBLIC FINAL OVERRIDE Kind : INT
    Kind := 20;
  END_METHOD
  SUPER();
  c := x;
END_FUNCTION_BLOCK

FUNCTION_BLOCK Runner
  VAR_IN_OUT inst : Derived1; END_VAR
  inst(a := 1, b := 2);
END_FUNCTION_BLOCK

FUNCTION KindOf : INT
  VAR_INPUT k : I_KIND; END_VAR
  IF k <> NULL THEN KindOf := k.Kind(); ELSE KindOf := -1; END_IF;
END_FUNCTION

FUNCTION_BLOCK Derived3 EXTENDS Derived1
  SUPER();
  x := x + 1000;
END_FUNCTION_BLOCK
INTERFACE I_ROOM
  METHOD DAYTIME END_METHOD
  METHOD NIGHTTIME END_METHOD
END_INTERFACE
FUNCTION_BLOCK ROOM_CTRL
  VAR_INPUT RM : I_ROOM; Night : BOOL; END_VAR
  IF RM = NULL THEN RETURN; END_IF;
  IF Night THEN RM.NIGHTTIME(); ELSE RM.DAYTIME(); END_IF;
END_FUNCTION_BLOCK
FUNCTION_BLOCK LIGHTROOM IMPLEMENTS I_ROOM
  VAR PUBLIC LIGHT : BOOL; END_VAR
  VAR PROTECTED level : INT; END_VAR
  METHOD PUBLIC DAYTIME LIGHT := FALSE; END_METHOD
  METHOD PUBLIC NIGHTTIME LIGHT := TRUE; level := 1; END_METHOD
  METHOD PROTECTED Dim level := level - 1; END_METHOD
END_FUNCTION_BLOCK
FUNCTION_BLOCK LIGHT2ROOM EXTENDS LIGHTROOM IMPLEMENTS I_ROOM
  VAR PUBLIC LIGHT2 : BOOL; END_VAR
  VAR ctrl : ROOM_CTRL; END_VAR
  VAR_INPUT Night : BOOL; END_VAR
  METHOD PUBLIC OVERRIDE DAYTIME
    SUPER.DAYTIME();
    LIGHT2 := TRUE;
  END_METHOD
  METHOD PUBLIC OVERRIDE NIGHTTIME
    SUPER.NIGHTTIME();
    LIGHT2 := FALSE;
    level := level + 10;
    THIS.Dim();
  END_METHOD
  ctrl(RM := THIS, Night := Night);
END_FUNCTION_BLOCK
FUNCTION_BLOCK ABSTRACT SHAPE
  VAR_OUTPUT area : REAL; END_VAR
  METHOD PUBLIC ABSTRACT Calc : REAL END_METHOD
  area := THIS.Calc();
END_FUNCTION_BLOCK
FUNCTION_BLOCK SQUARE EXTENDS SHAPE
  VAR_INPUT side : REAL; END_VAR
  METHOD PUBLIC Calc : REAL Calc := side * side; END_METHOD
  SUPER();
END_FUNCTION_BLOCK
